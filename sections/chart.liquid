{{ 'chart.css' | asset_url | stylesheet_tag }}

<section class="comparison-chart" style="
    background: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="page-width">

    <!-- Header -->
    <div class="comparison-chart__header">

      {% for block in section.blocks %}

      {% case block.type %}

      {% when 'tag' %}

      <p class="comparison-chart__eyebrow" {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </p>

      {% when 'heading' %}

      <h2 class="comparison-chart__heading" {{ block.shopify_attributes }}>
        {{ block.settings.heading }}
      </h2>

      {% when 'description' %}

      <div class="comparison-chart__description" {{ block.shopify_attributes }}>
        {{ block.settings.description }}
      </div>

      {% endcase %}

      {% endfor %}

    </div>

    <!-- Comparison Table -->
    <div class="comparison-chart__table">

      <!-- Table Header -->
      {% for block in section.blocks %}

      {% if block.type == 'table_header' %}

      <div class="comparison-chart__row comparison-chart__row--heading" {{ block.shopify_attributes }}>

        <div class="comparison-chart__feature"></div>

        <div class="comparison-chart__column-title">
          {{ block.settings.column_1 }}
        </div>

        <div class="comparison-chart__column-title">
          {{ block.settings.column_2 }}
        </div>

        <div class="comparison-chart__column-title">
          {{ block.settings.column_3 }}
        </div>

      </div>

      {% endif %}

      {% endfor %}

      <!-- Comparison Rows -->
      {% for block in section.blocks %}

      {% if block.type == 'row' %}

      <div class="comparison-chart__row" {{ block.shopify_attributes }}>

        <!-- Feature -->
        <div class="comparison-chart__feature">
          {{ block.settings.feature }}
        </div>

        <!-- Column 1 -->
        <div class="comparison-chart__cell">

          {% if block.settings.party_patch == 'check' %}

          <span class="check">✓</span>

          {% else %}

          <span class="cross">✕</span>

          {% endif %}

        </div>

        <!-- Column 2 -->
        <div class="comparison-chart__cell">

          {% if block.settings.pills == 'check' %}

          <span class="check">✓</span>

          {% else %}

          <span class="cross">✕</span>

          {% endif %}

        </div>

        <!-- Column 3 -->
        <div class="comparison-chart__cell">

          {% if block.settings.drink_mix == 'check' %}

          <span class="check">✓</span>

          {% else %}

          <span class="cross">✕</span>

          {% endif %}

        </div>

      </div>

      {% endif %}

      {% endfor %}

    </div>

    <!-- Button -->
    <div class="comparison-chart__footer">

      {% for block in section.blocks %}

      {% if block.type == 'button' %}

      <a href="{{ block.settings.link }}" class="comparison-chart__button" {{ block.shopify_attributes }}>
        {{ block.settings.label }}
      </a>

      {% endif %}

      {% endfor %}

    </div>

  </div>
</section>

{% schema %}

