{{ 'faq.css' | asset_url | stylesheet_tag }}

<section
  class="faq-section"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="faq-section__container">

    {% if section.settings.eyebrow != blank %}
      <p class="faq-section__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="faq-section__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="faq-section__list">

        {% for block in section.blocks %}
          <details
            class="faq-item"
            {{ block.shopify_attributes }}
            data-faq-item="{{ block.id }}"
          >

            <summary class="faq-item__question">

              <span class="faq-item__question-text">
                {{ block.settings.question }}
              </span>

              <span
                class="faq-item__icon"
                aria-hidden="true"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M4 6L8 10L12 6"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

            </summary>

            {% if section.settings.enable_comments %}
              <div class="faq-comments">

                <h3 class="faq-comments__title">
                  {{ section.settings.comments_heading }}
                </h3>

                <form
                  class="faq-comments__form"
                  data-comment-form
                  novalidate
                >

                  <div class="faq-comments__field">
                    <label for="faq-name-{{ block.id }}">
                      Name
                    </label>

                    <input
                      id="faq-name-{{ block.id }}"
                      type="text"
                      name="name"
                      placeholder="Your name"
                      required
                      autocomplete="name"
                    >
                  </div>

                  <div class="faq-comments__field">
                    <label for="faq-comment-{{ block.id }}">
                      Comment
                    </label>

                    <textarea
                      id="faq-comment-{{ block.id }}"
                      name="comment"
                      placeholder="Write your comment..."
                      rows="4"
                      required
                    ></textarea>
                  </div>

                  <button
                    type="submit"
                    class="faq-comments__submit"
                  >
                    {{ section.settings.submit_text }}
                  </button>

                  <p
                    class="faq-comments__message"
                    data-comment-message
                    role="status"
                    aria-live="polite"
                  ></p>

                </form>

                <div
                  class="faq-comments__list"
                  data-comments-list
                ></div>

              </div>
            {% endif %}

          </details>
        {% endfor %}

      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "checkbox",
      "id": "enable_comments",
      "label": "Enable comments",
      "default": true
    },
    {
      "type": "text",
      "id": "comments_heading",
      "label": "Comments heading",
      "default": "Comments"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit button text",
      "default": "Post Comment"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is Party Patch?"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is Party Patch?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How does Party Patch work?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long should I wear it?"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where can I buy Party Patch?"
          }
        }
      ]
    }
  ]
}
{% endschema %}