{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<section class="hero-banner" style="
    background: {{ section.settings.background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="page-width">

    <div class="hero-banner__wrapper">

      <!-- Left Content -->
      <div class="hero-banner__content">

        {% for block in section.blocks %}

        {% case block.type %}

        {% when 'tag' %}
        <div class="hero-banner__tag" {{ block.shopify_attributes }}>
          {{ block.settings.text }}
        </div>

        {% when 'heading' %}
        <h1 class="hero-banner__heading" {{ block.shopify_attributes }}>
          {{ block.settings.heading }}
        </h1>

        {% when 'description' %}
        <div class="hero-banner__description" {{ block.shopify_attributes }}>
          {{ block.settings.description }}
        </div>

        {% when 'bullet' %}
        <div class="hero-banner__bullet" {{ block.shopify_attributes }}>
          <span class="hero-banner__check">✓</span>
          <span>{{ block.settings.text }}</span>
        </div>

        {% when 'button' %}
        <a href="{{ block.settings.link }}" class="hero-banner__button" {{ block.shopify_attributes }}>
          {{ block.settings.label }}
        </a>

        {% endcase %}

        {% endfor %}

      </div>

      <!-- Right Image -->
      <div class="hero-banner__image">

        {% if section.settings.image != blank %}

        {{
        section.settings.image
        | image_url: width: 900
        | image_tag:
        class: 'hero-banner__image-img',
        loading: 'lazy',
        alt: section.settings.image.alt
        }}

        {% else %}

        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}

        {% endif %}

      </div>

    </div>

  </div>

  <!-- Bottom Features -->
  <div class="hero-banner__features">

    <div class="page-width">

      <div class="hero-banner__features-wrapper">

        {% for block in section.blocks %}

        {% if block.type == 'feature' %}

        <div class="hero-banner__feature" {{ block.shopify_attributes }}>

          {% if block.settings.icon != blank %}

          {{
          block.settings.icon
          | image_url: width: 50
          | image_tag:
          class: 'hero-banner__feature-icon',
          loading: 'lazy',
          alt: block.settings.title
          }}

          {% endif %}

          <div>
            <strong>{{ block.settings.title }}</strong>
            <p>{{ block.settings.subtitle }}</p>
          </div>

        </div>

        {% endif %}

        {% endfor %}

      </div>

    </div>

  </div>

</section>

