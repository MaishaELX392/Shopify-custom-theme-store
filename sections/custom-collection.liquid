
{{ 'custom-collection.css' | asset_url | stylesheet_tag }}

<section class="custom-collection">
  <div class="custom-collection__container">

    {% if section.settings.heading != blank %}
      <header class="custom-collection__header">

        <h1 class="custom-collection__title">
          {{ section.settings.heading }}
        </h1>

        {% if section.settings.description != blank %}
          <div class="custom-collection__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      </header>
    {% endif %}


    <div
      class="
        custom-collection__grid
        custom-collection__grid--{{ section.settings.desktop_columns }}
        custom-collection__grid-mobile--{{ section.settings.mobile_columns }}
      "
    >

      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        {% if product != blank %}

          {% assign current_variant = product.selected_or_first_available_variant %}

          <article
            class="custom-product-card"
            {{ block.shopify_attributes }}
          >

            {% comment %}
              PRODUCT IMAGE
            {% endcomment %}

            {% if section.settings.show_product_image %}

              <a
                href="{{ product.url }}"
                class="custom-product-card__image-link"
              >

                <div class="custom-product-card__image-wrapper">

                  {% if product.featured_image != blank %}

                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'custom-product-card__image',
                        alt: product.featured_image.alt | default: product.title
                    }}

                  {% else %}

                    {{ 'product-1' | placeholder_svg_tag: 'custom-product-card__placeholder' }}

                  {% endif %}

                </div>

              </a>

            {% endif %}


            <div class="custom-product-card__content">

              {% comment %}
                PRODUCT VENDOR
              {% endcomment %}

              {% if section.settings.show_vendor and product.vendor != blank %}

                <div class="custom-product-card__vendor">
                  {{ product.vendor }}
                </div>

              {% endif %}


              {% comment %}
                PRODUCT TITLE
              {% endcomment %}

              {% if section.settings.show_product_title %}

                <h2 class="custom-product-card__title">

                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>

                </h2>

              {% endif %}


              {% comment %}
                PRODUCT DESCRIPTION
              {% endcomment %}

              {% if section.settings.show_description and product.description != blank %}

                <div class="custom-product-card__description">
                  {{ product.description | strip_html | truncatewords: 20 }}
                </div>

              {% endif %}


              {% comment %}
                PRODUCT PRICE
              {% endcomment %}

              {% if section.settings.show_price %}

                <div class="custom-product-card__price">

                  {% if current_variant.compare_at_price > current_variant.price %}

                    <span class="custom-product-card__price-sale">
                      {{ current_variant.price | money }}
                    </span>

                    <span class="custom-product-card__price-compare">
                      {{ current_variant.compare_at_price | money }}
                    </span>

                  {% else %}

                    <span class="custom-product-card__price-current">
                      {{ current_variant.price | money }}
                    </span>

                  {% endif %}

                </div>

              {% endif %}


              {% comment %}
                AVAILABILITY
              {% endcomment %}

              {% if section.settings.show_availability %}

                <div class="custom-product-card__availability">

                  {% if current_variant.available %}

                    <span class="custom-product-card__availability--available">
                      In stock
                    </span>

                  {% else %}

                    <span class="custom-product-card__availability--sold-out">
                      Sold out
                    </span>

                  {% endif %}

                </div>

              {% endif %}


              {% comment %}
                ADD TO CART
              {% endcomment %}

              {% if section.settings.show_add_to_cart %}

                {% form 'product',
                  product,
                  class: 'custom-product-card__form'
                %}

                  <input
                    type="hidden"
                    name="id"
                    value="{{ current_variant.id }}"
                  >

                  {% render 'add-to-cart-button',
                    can_add_to_cart: current_variant.available,
                    add_to_cart_text: 'Add to cart',
                    product: product,
                    class: 'custom-product-card__add-to-cart'
                  %}

                {% endform %}

              {% endif %}


              {% comment %}
                VIEW PRODUCT
              {% endcomment %}

              {% if section.settings.show_view_product %}

                <a
                  href="{{ product.url }}"
                  class="custom-product-card__view-product"
                >
                  View product
                </a>

              {% endif %}

            </div>

          </article>

        {% else %}

          <div
            class="custom-product-card custom-product-card--empty"
            {{ block.shopify_attributes }}
          >
            <div class="custom-product-card__empty-content">
              <p>Select a product</p>
            </div>
          </div>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>


{% schema %}
{
  "name": "Custom Collection",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "show_product_image",
      "label": "Show product image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_product_title",
      "label": "Show product name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_availability",
      "label": "Show availability",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show Add to cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_product",
      "label": "Show View product link",
      "default": true
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        },
        {
          "value": "6",
          "label": "6 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Collection",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}

