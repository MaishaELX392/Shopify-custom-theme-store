<div
  class="vitamin-powerhouse__card"
  {{ block.shopify_attributes }}
>
  {% if block.settings.icon != blank %}
    <div class="vitamin-powerhouse__icon">
      {{
        block.settings.icon
        | image_url: width: 80
        | image_tag:
          loading: 'lazy',
          widths: '40, 60, 80',
          sizes: '40px',
          alt: block.settings.title
      }}
    </div>
  {% endif %}

  <div class="vitamin-powerhouse__content">

    {% if block.settings.title != blank %}
      <h3 class="vitamin-powerhouse__title">
        {{ block.settings.title }}
      </h3>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="vitamin-powerhouse__text">
        {{ block.settings.text }}
      </div>
    {% endif %}

  </div>
</div>